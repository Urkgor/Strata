+bool llama_model_expert_tensors(const llama_model * model, int il, llama_hybrid_experts * out) {
+    if (!model || !out || il < 0 || (size_t) il >= model->layers.size()) {
+        return false;
+    }
+    const llama_layer & l = model->layers[il];
+    if (!l.ffn_gate_inp || !l.ffn_down_exps || !(l.ffn_up_exps || l.ffn_gate_up_exps)) {
+        return false;
+    }
+    out->gate_inp   = l.ffn_gate_inp;
+    out->up         = l.ffn_up_exps;
+    out->gate       = l.ffn_gate_exps;
+    out->gate_up    = l.ffn_gate_up_exps;
+    out->down       = l.ffn_down_exps;
+    out->has_scales = l.ffn_up_exps_s || l.ffn_gate_exps_s || l.ffn_down_exps_s ||
+                      l.ffn_up_exps_b || l.ffn_gate_exps_b || l.ffn_down_exps_b || l.ffn_gate_up_exps_b;
+    return true;
+}
+
+void llama_model_set_hybrid(llama_model * model, llama_hybrid * h) {
+    model->hybrid = h;
+}
