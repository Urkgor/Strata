diff --git a/src/llama-hybrid.h b/src/llama-hybrid.h
new file mode 100644
index 0000000..3dc57f3
--- /dev/null
+++ b/src/llama-hybrid.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// Strata's hybrid expert cache (q35/patches/0001-hybrid-expert-cache.patch).
+//
+// The routed experts of a MoE layer that live in RAM are computed by the CPU.  Here, a few of them are also copied to
+// the graphics card; for those the card does the work and the CPU is asked for the others only.  The graph of a layer
+// is built like this when the batch is small (decoding):
+//
+//     ids [n_used, n_tokens]  the experts the router picked
+//     card:  slot  = slot_i[ids]            where in the cache an expert sits (0 when it is not there)
+//            w_hit = weights * hit_f[ids]   its weight, or exactly 0 when it is not in the cache
+//            out_card = sum_k  w_hit_k * down_cache[slot_k] (swiglu(gate_cache[slot_k] x, up_cache[slot_k] x))
+//     CPU:   id    = cpu_i[ids]             the expert itself, or one fixed stand-in when it is in the cache
+//            w_miss = weights * miss_f[ids]  its weight, or exactly 0 when it is in the cache
+//            out_cpu  = the same with the experts in RAM
+//     out = out_card + out_cpu
+//
+// An expert that is in the cache contributes w * E(x) on the card and 0 * E'(x) on the CPU (E' is the stand-in, read
+// once whatever the number of hits); one that is not contributes the other way round, so the output is the plain
+// mixture of experts, up to the order of the float additions.  The four small tables are rewritten by the host between
+// two decode calls; the weights of the experts are copied into the cache slots by the host too.
+//
+// The routing of every token (the ids) is also copied into `trace`, so the host learns which experts are hot.
+//
+// The host side is q35/hybrid_experts.cpp; the policy that decides what is cached is q35/expert_cache.h.
+
+#include "ggml.h"
+#include "llama.h"
+
+#include <vector>
+
+struct llama_hybrid_layer {
+    // the cache: [ne0, ne1, n_slots] like the model's own tensor, in the card's memory (null: no cache for this layer)
+    ggml_tensor * up      = nullptr;
+    ggml_tensor * gate    = nullptr;
+    ggml_tensor * gate_up = nullptr;   // when the model's gate and up are one tensor
+    ggml_tensor * down    = nullptr;
+
+    ggml_tensor * hit_f   = nullptr;   // F32 [1, n_expert] on the card: 1 when the expert is in the cache, else 0
+    ggml_tensor * slot_i  = nullptr;   // I32 [1, n_expert] on the card: its slot (0 when absent)
+    ggml_tensor * miss_f  = nullptr;   // F32 [1, n_expert] in RAM: 0 when the expert is in the cache, else 1
+    ggml_tensor * cpu_i   = nullptr;   // I32 [1, n_expert] in RAM: the expert's own id, or the stand-in when it is cached
+
+    // I32 [n_used, n_layer, trace_tokens] (token-major, one per card): the router's choice is copied to
+    // trace[:, il, token] by the graph; null: not recorded
+    ggml_tensor * trace   = nullptr;
+};
+
+struct llama_hybrid {
+    bool enabled      = false;   // false: every layer is built as in stock llama.cpp (the trace is still recorded)
+    int  max_tokens   = 16;      // the hybrid graph is used for batches of up to this many tokens
+    int  trace_tokens = 0;       // rows (tokens) of each trace tensor; a larger batch is not recorded
+    std::vector<llama_hybrid_layer> layers;   // by layer index (empty entries: no cache there)
+};
+
+// the experts of MoE layer il as the model holds them; false for a layer without routed experts
+struct llama_hybrid_experts {
+    ggml_tensor * gate_inp = nullptr;
+    ggml_tensor * up       = nullptr;
+    ggml_tensor * gate     = nullptr;
+    ggml_tensor * gate_up  = nullptr;
+    ggml_tensor * down     = nullptr;
+    bool          has_scales = false;   // per-expert scale tensors (not supported by the cache)
+};
+
+LLAMA_API bool llama_model_expert_tensors(const struct llama_model * model, int il, struct llama_hybrid_experts * out);
+
+// attaches `h` to the model (not owned; null detaches).  Call before the first decode of a context.
+LLAMA_API void llama_model_set_hybrid(struct llama_model * model, struct llama_hybrid * h);
