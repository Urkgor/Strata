+// Strata's hybrid expert cache: see llama-hybrid.h
+ggml_tensor * llm_graph_context::build_moe_hybrid(
+         ggml_tensor * cur,
+         ggml_tensor * ids,
+         ggml_tensor * weights,
+         ggml_tensor * up_exps,
+         ggml_tensor * gate_exps,
+         ggml_tensor * gate_up_exps,
+         ggml_tensor * down_exps,
+             int64_t   n_expert,
+             int64_t   n_expert_used,
+     llm_ffn_op_type   type_op,
+                bool   plain,
+                 int   il) const {
+    const llama_hybrid * hy = hybrid;
+    if (!hy || il < 0 || (size_t) il >= hy->layers.size()) {
+        return nullptr;
+    }
+    const llama_hybrid_layer & L = hy->layers[il];
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+    GGML_UNUSED(n_expert);
+
+    // the router's choice, for the host: also while the layer is built the usual way (a long prompt teaches the cache)
+    if (L.trace && n_tokens <= hy->trace_tokens && L.trace->ne[0] == n_expert_used && il < L.trace->ne[1]) {
+        ggml_tensor * dst = ggml_view_2d(ctx0, L.trace, n_expert_used, n_tokens, L.trace->nb[2], (size_t) il * L.trace->nb[1]);
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ids, dst));
+    }
+
+    if (!hybrid_on || !plain || !L.hit_f || !L.slot_i || !L.miss_f || !L.cpu_i || !L.down ||
+        n_tokens > hy->max_tokens || cur->ne[2] != 1 || type_op != LLM_FFN_SILU) {
+        return nullptr;
+    }
+    if (hparams.swiglu_clamp_exp[il] > 1e-6f) {
+        return nullptr;
+    }
+    const bool merged = gate_up_exps != nullptr;
+    if (merged ? !L.gate_up : !(L.up && L.gate && up_exps && gate_exps)) {
+        return nullptr;
+    }
+
+    ggml_tensor * ids_c    = ggml_is_contiguous(ids) ? ids : ggml_cont(ctx0, ids);
+    ggml_tensor * ids_flat = ggml_reshape_2d(ctx0, ids_c, n_expert_used * n_tokens, 1);
+    auto lookup = [&](ggml_tensor * table) { return ggml_get_rows(ctx0, table, ids_flat); };   // [1, n_used * n_tokens]
+    auto per_slot = [&](ggml_tensor * t) { return ggml_reshape_3d(ctx0, t, 1, n_expert_used, n_tokens); };
+
+    // One half of the layer: `ids2` [n_used, n_tokens] picks the experts out of up_t / gate_t / down_t, `w3` weighs them.
+    // Returns [n_embd, n_used, n_tokens]: what every slot of every token contributes.
+    auto half = [&](ggml_tensor * up_t, ggml_tensor * gate_t, ggml_tensor * gate_up_t, ggml_tensor * down_t,
+                    ggml_tensor * ids2, ggml_tensor * w3, const char * part) -> ggml_tensor * {
+        ggml_tensor * x = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+        ggml_tensor * g = nullptr;
+        ggml_tensor * u = nullptr;
+        if (gate_up_t) {
+            ggml_tensor * gu = ggml_mul_mat_id(ctx0, gate_up_t, x, ids2);
+            const int64_t n_ff = gu->ne[0] / 2;
+            g = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], 0);
+            u = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], n_ff * gu->nb[0]);
+        } else {
+            u = ggml_mul_mat_id(ctx0, up_t, x, ids2);
+            g = ggml_mul_mat_id(ctx0, gate_t, x, ids2);
+        }
+        cb(u, (std::string("ffn_moe_up_") + part).c_str(), il);
+        ggml_tensor * h = ggml_swiglu_split(ctx0, g, u);
+        ggml_tensor * e = ggml_mul_mat_id(ctx0, down_t, h, ids2);   // [n_embd, n_used, n_tokens]
+        e = ggml_mul(ctx0, e, w3);
+        cb(e, (std::string("ffn_moe_down_") + part).c_str(), il);
+        ggml_build_forward_expand(gf, e);
+        return e;
+    };
+
+    // The card first: the experts that are in the cache (the others get weight 0 and slot 0).
+    ggml_tensor * slot  = ggml_reshape_2d(ctx0, lookup(L.slot_i), n_expert_used, n_tokens);
+    ggml_tensor * w_hit = ggml_mul(ctx0, weights, per_slot(lookup(L.hit_f)));
+    ggml_tensor * e_card = half(L.up, L.gate, L.gate_up, L.down, slot, w_hit, "hot");
+
+    // Then the CPU: the experts that are not.  The cached ones are replaced by one stand-in expert with weight 0, so a
+    // token may name the same expert several times.  The CPU's mul_mat_id keeps room for that: the generic one always
+    // did, and the repacked one (ggml-cpu/repack.cpp) does since the same patch.
+    ggml_tensor * rid    = ggml_reshape_2d(ctx0, lookup(L.cpu_i), n_expert_used, n_tokens);
+    ggml_tensor * w_miss = ggml_mul(ctx0, weights, per_slot(lookup(L.miss_f)));
+    ggml_tensor * e_cpu  = half(up_exps, gate_exps, gate_up_exps, down_exps, rid, w_miss, "cold");
+
+    // For every slot exactly one of the two is not zero, so the sum is exact; the slots are then added in the order
+    // build_moe_ffn adds them, which makes the result the same as without the cache (up to the kernels' own differences).
+    ggml_tensor * e = ggml_add(ctx0, e_card, e_cpu);
+    ggml_build_forward_expand(gf, e);
+
+    ggml_tensor * moe_out = ggml_view_2d(ctx0, e, n_embd, n_tokens, e->nb[2], 0);
+    ggml_build_forward_expand(gf, moe_out);
+    for (int64_t i = 1; i < n_expert_used; ++i) {
+        moe_out = ggml_add(ctx0, moe_out, ggml_view_2d(ctx0, e, n_embd, n_tokens, e->nb[2], i * e->nb[1]));
+        ggml_build_forward_expand(gf, moe_out);
+    }
+    if (n_expert_used == 1) {
+        moe_out = ggml_cont(ctx0, moe_out);
+    }
+    cb(moe_out, "ffn_moe_out", il);
+    return moe_out;
+}
+
